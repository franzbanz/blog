<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>franzkoehler.com</title>
    <link rel="icon" type="image/x-icon" href="/src/bilder/favicon.ico">
    <link rel="stylesheet" href="/src/style.css">
    {% if includesMath %}
    <script>
    window.MathJax = {
        tex: {
        inlineMath: [['$', '$'], ['\\(', '\\)']],
        displayMath: [['$$', '$$'], ['\\[', '\\]']]
        },
        svg: { fontCache: 'global' }
    };
    </script>
    <script defer src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    {% endif %}

    </head>
    <body>
        <header>
            <nav>
                <ul class="nav">
                    <li class="nav"><a style="float: left;" href="/">franzkoehler.com</a></li>
                    <li class="nav"><a style="float: right;" href="https://github.com/franzbanz/blog">github</a></li>
                </ul>
            </nav>
        </header>
        {{ content }}
    </body>
</html>