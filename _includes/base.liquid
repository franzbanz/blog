<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>franzkoehler.com</title>
    <link rel="stylesheet" href="/src/style.css">
    {% if includesMath %}
        <script type="text/javascript"
            src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.0/MathJax.js?config=TeX-AMS_CHTML">
        </script>
        <script type="text/x-mathjax-config">
            MathJax.Hub.Config({
                tex2jax: {
                    inlineMath: [['$','$'], ['\\(','\\)']],
                    processEscapes: true
                },
                jax: ["input/TeX", "input/MathML", "input/AsciiMath", "output/CommonHTML"],
                extensions: [
                    "tex2jax.js", "mml2jax.js", "asciimath2jax.js",
                    "MathMenu.js", "MathZoom.js", "AssistiveMML.js", 
                    "[Contrib]/a11y/accessibility-menu.js", "linebreaks.js"  // Add linebreaks extension
                ],
                TeX: {
                    extensions: ["AMSmath.js", "AMSsymbols.js", "noErrors.js", "noUndefined.js"],
                    equationNumbers: { autoNumber: "AMS" }
                }
            });
        </script>
    {% endif %}

    </head>
    <body>
        <header>
            <nav>
                <ul class="nav">
                    <li class="nav"><a style="float: left;" href="/">franzkoehler.com</a></li>
                    <li class="nav"><a style="float: right;" href="https://github.com/franzbanz/blog">github</a></li>
                </ul>
            </nav>
        </header>
        {{ content }}
    </body>
</html>