<section class="lecture_section">
    <h2>Mitschriften</h2>
    {% assign sorted_notes = collections.notes | sort: 'date' | reverse %}
    {% assign grouped_notes = sorted_notes | group_by: 'data.course' %}
    {% for group in grouped_notes %}
        <h3>{{ group.name }}</h3>
        <ol>
            {% for note in group.items %}
            <li class="list_item">
                <a href="{{ note.url }}">
                    <table class="list_table">
                        <tr>
                        <td class="list_date">{{ note.data.date | date: "%d %B, %Y" }}</td>
                        <td class="list_type">{{ note.data.type }}</td>
                        </tr>
                    </table>
                </a>
            </li>
            {% endfor %}
        </ol>
    {% endfor %}
</section>

