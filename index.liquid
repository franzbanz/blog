    <section class="exam_subsection">
        <h2>Prüfungsvorbereitung</h2>
        <ol>
            <li class="list_item"><a href="/src/pdfs/HM3.pdf" target="_blank">Höhere Mathematik 3</a></li>
            <li class="list_item"><a href="/src/pdfs/LFT.pdf" target="_blank">Luftfahrttechnik</a></li>
            <li class="list_item"><a href="/src/pdfs/SYSTEME1.pdf" target="_blank">Luftfahrtsysteme</a></li>
            <li class="list_item"><a href="/src/pdfs/NUMSIM.pdf" target="_blank">Numerische Simulation</a></li>
            <li class="list_item"><a href="/src/pdfs/RAUMFAHRT.pdf" target="_blank">Raumfahrt</a></li>
            <li class="list_item"><a href="/src/pdfs/STATIK.pdf" target="_blank">Statik</a></li>
            <li class="list_item"><a href="/src/pdfs/STROEMUNG1.pdf" target="_blank">Strömungslehre 1</a></li>
            <li class="list_item"><a href="/src/pdfs/STROEMUNG2.pdf" target="_blank">Strömungslehre 2</a></li>
            <li class="list_item"><a href="/src/pdfs/THERMO.pdf" target="_blank">Thermodynamik</a></li>
            <li class="list_item"><a href="/src/pdfs/TM2.pdf" target="_blank">Technische Mechanik 2</a></li>
            <li class="list_item"><a href="/src/pdfs/TM3.pdf" target="_blank">Technische Mechanik 3</a></li>
            <li class="list_item"><a href="/src/pdfs/FEM.pdf" target="_blank">Finite Elemente (Vorläufige Version)</a></li>
        </ol>
    </section>
</section>

<section class="lecture_section">
    <h2 class="section_heading">
        <span class=""section_heading_text>Mitschriften</span>
        <span id="page_controls">
            <button id="prev_btn" disabled>prev</button><button id="next_btn">next</button>
        </span>
    </h2>
    <div id="course_sections">
        {% assign sorted_notes = collections.notes | sort: "date" | reverse %}
        {% assign course_names = "" | split: "" %}
        {% for note in sorted_notes %}
            {% unless course_names contains note.data.course %}
                {% assign course_names = course_names | push: note.data.course %}
            {% endunless %}
        {% endfor %}

        {% for course in course_names %}
        <div class="course_section">
            <h3>{{ course }}</h3>
            <ol>
                {% for note in sorted_notes %}
                {% if note.data.course == course %}
                    <li class="list_item">
                    <a href="{{ note.url }}">
                        <table class="list_table">
                        <tr>
                            <td class="list_date">{{ note.data.date | date: "%d %b, %Y" }}</td>
                            <td class="list_type">{{ note.data.type }}</td>
                        </tr>
                        </table>
                    </a>
                    </li>
                {% endif %}
                {% endfor %}
            </ol>
        </div>
        {% endfor %}
    </div>
</section>

